<nav class="navbar">
  <div class="logo">
    HU
  </div>

  <div class="menu">
    <a href="/">Inicio</a>
    <a href="/about">Sobre Mí</a>
    <a href="/experience">Experiencia</a>
    <a href="/projects">Proyectos</a>
    <a href="/dashboard">Dashboard</a>
    <a href="/skills">Habilidades</a>
    <a href="/certifications">Certificaciones</a>
    <a href="/contact">Contacto</a>
  </div>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 1000;

    display: flex;
    justify-content: center;
    align-items: center;

    gap: 30px;

    width: 100%;
    box-sizing: border-box;

    padding: 18px 30px;

    background: rgba(15, 23, 42, 0.95);
    backdrop-filter: blur(12px);

    border-bottom: 1px solid #1e293b;
  }

  .logo {
    color: #38bdf8;
    font-size: 1.8rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .menu {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 30px;
    flex-wrap: wrap;
  }

  .menu a {
    position: relative;

    color: #f8fafc;
    text-decoration: none;
    font-weight: 600;

    white-space: nowrap;

    padding: 8px 0;

    transition:
      color 0.3s ease,
      transform 0.3s ease;
  }

  .menu a::after {
    content: "";

    position: absolute;
    left: 0;
    bottom: 0;

    width: 0;
    height: 2px;

    background: #38bdf8;

    transition: width 0.3s ease;
  }

  .menu a:hover {
    color: #38bdf8;
    transform: translateY(-2px);
  }

  .menu a:hover::after {
    width: 100%;
  }

  @media (max-width: 1000px) {
    .navbar {
      gap: 20px;
      padding: 15px 20px;
    }

    .menu {
      gap: 18px;
    }
  }

  @media (max-width: 768px) {
    .navbar {
      flex-direction: column;
      gap: 12px;
    }

    .menu {
      gap: 12px 18px;
    }

    .menu a {
      font-size: 0.9rem;
    }
  }
</style>
