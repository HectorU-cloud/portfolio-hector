---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<MainLayout title="Experiencia Profesional">

  <Navbar />

  <div class="container">

    <h1 class="title">
      Experiencia Profesional
    </h1>

    <div class="timeline">

      <div class="timeline-item">
        <div class="timeline-dot"></div>

        <div class="timeline-content">

          <h2>
            Ingeniero de Aseguramiento Corporativo
          </h2>

          <span class="date">
            Actualidad
          </span>

          <p>
            Gestión de infraestructura tecnológica,
            inventarios corporativos y activos TI.
          </p>

          <ul>
            <li>Administración de activos tecnológicos</li>
            <li>Control de infraestructura Dell</li>
            <li>Gestión de switches corporativos</li>
            <li>Automatización con Python</li>
          </ul>

        </div>

      </div>

    </div>

  </div>

  <Footer />

</MainLayout>

<style>

.timeline{
  position:relative;
  margin-top:40px;
}

.timeline::before{
  content:'';
  position:absolute;
  left:12px;
  top:0;
  width:3px;
  height:100%;
  background:#0ea5e9;
}

.timeline-item{
  position:relative;
  padding-left:50px;
  margin-bottom:40px;
}

.timeline-dot{
  width:25px;
  height:25px;
  background:#0ea5e9;
  border-radius:50%;
  position:absolute;
  left:0;
}

.timeline-content{
  background:#1e293b;
  padding:25px;
  border-radius:16px;
}

.date{
  color:#38bdf8;
  font-weight:bold;
}

</style>

