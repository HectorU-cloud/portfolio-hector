---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const focus = [
  { label: "Inventarios tecnológicos", detail: "Control y trazabilidad de activos TI a escala corporativa." },
  { label: "Gestión de activos TI", detail: "Ciclo de vida completo: alta, seguimiento y baja de equipos." },
  { label: "Switches y redes", detail: "Administración de dispositivos Cisco y Fortinet." },
  { label: "Infraestructura Dell", detail: "Soporte y control de infraestructura de servidores Dell." },
  { label: "Automatización con Python", detail: "Scripts y herramientas para auditoría y trazabilidad." },
];
---

<MainLayout title="Sobre mí">

<Navbar />

<div class="container">

  <span class="eyebrow">Perfil</span>
  <h1 class="title">
    Sobre Mí
  </h1>

  <div class="card intro-card">
    <p>
      Profesional enfocado en aseguramiento corporativo e
      infraestructura TI, con experiencia administrando una flota
      de red a gran escala y automatizando procesos de auditoría
      y trazabilidad de activos.
    </p>
  </div>

  <div class="specialities">
    {focus.map(item => (
      <div class="card focus-card">
        <h3>{item.label}</h3>
        <p>{item.detail}</p>
      </div>
    ))}
  </div>

</div>
<Footer />
</MainLayout>

<style>
  .intro-card {
    margin-bottom: 40px;
  }

  .intro-card p {
    color: var(--text-muted);
    line-height: 1.7;
    font-size: 1.05rem;
  }

  .focus-card h3 {
    font-size: 1.05rem;
    margin-bottom: 8px;
  }

  .focus-card p {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }
</style>
