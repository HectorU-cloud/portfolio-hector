---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.jsx';

const projects = [
{
title:"Corporate Infrastructure Dashboard",
description:"Dashboard para gestión de activos TI, switches, infraestructura Dell y KPIs.",
technologies:["Astro","React","FastAPI","PostgreSQL"]
},
{
title:"Sistema de Inventario Tecnológico",
description:"Control completo de activos y trazabilidad.",
technologies:["Python","FastAPI","SQL"]
},
{
title:"Monitoreo de Redes",
description:"Visualización y monitoreo de infraestructura empresarial.",
technologies:["React","Node.js","Docker"]
}
];
---

<MainLayout title="Proyectos">

<Navbar />

<div class="container">

<h1 class="title">
Proyectos Destacados
</h1>

<div class="grid">

{
projects.map(project => (

<ProjectCard
client:load
title={project.title}
description={project.description}
technologies={project.technologies}
/>

))
}

</div>

</div>

<Footer />

</MainLayout>

<style>
.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(350px,1fr));
gap:20px;
}
</style>