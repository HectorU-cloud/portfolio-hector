---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.jsx';

const projects = [
{
title: "Corporate Infrastructure Dashboard",
description: "Plataforma interna para dar seguimiento a activos TI, switches corporativos e infraestructura Dell: inventario, disponibilidad e indicadores clave centralizados.",
technologies: ["Astro","React","FastAPI","PostgreSQL"],
status: "produccion",
},
{
title: "Auditoría de cuentas de servicio en red",
description: "Script en Python con Netmiko que audita cerca de 1000 dispositivos de red para verificar la existencia y los permisos de escritura de una cuenta de servicio específica. Resuelve timeouts de autodetección SSH y bloqueos de autenticación en sistemas AAA/TACACS+ al paralelizar, y genera un CSV con columna de motivo de falla para diagnóstico rápido.",
technologies: ["Python","Netmiko","SSH","CSV"],
status: "produccion",
},
{
title: "Bot de sincronización de inventario por correo",
description: "Automatización que lee notificaciones de NOC (migración o retiro de equipos) desde el correo corporativo vía Microsoft Graph API y actualiza o elimina los registros correspondientes en las tablas de inventario de la base de datos, sin intervención manual.",
technologies: ["Python","Microsoft Graph API","SQL"],
status: "desarrollo",
}
];
---

<MainLayout title="Proyectos">

<Navbar />

<div class="container">

<span class="eyebrow">Trabajo</span>
<h1 class="title">
Proyectos Destacados
</h1>

<div class="grid">

{
projects.map(project => (

<ProjectCard
client:load
title={project.title}
description={project.description}
technologies={project.technologies}
status={project.status}
/>

))
}

</div>

</div>

<Footer />

</MainLayout>

<style>
.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(340px,1fr));
gap:20px;
}
</style>
