---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import ProfileCard from '../components/ProfileCard.jsx';
import Footer from '../components/Footer.astro';
---

<MainLayout title="Inicio">

  <Navbar />

  <!-- HERO -->

  <section class="hero container">

    <div class="hero-content">

      <div>

        <span class="badge">
          Ingeniero de Aseguramiento Corporativo
        </span>

        <h1>
          Héctor Urgiles
        </h1>

        <p>
          Administro y aseguro infraestructura de red corporativa a
          gran escala: dispositivos Cisco y Fortinet, inventario de
          activos TI e infraestructura Dell. Automatizo procesos de
          auditoría y trazabilidad con Python, FastAPI y React.
        </p>

        <div class="buttons">

          <a href="/projects" class="btn-primary">
            Ver Proyectos
          </a>

          <a href="/dashboard" class="btn-secondary">
            Dashboard TI
          </a>
          <a href="/cv-hector-urgiles.pdf" class="btn-secondary" target="_blank">
            Descargar CV
          </a>

        </div>

      </div>

      <ProfileCard client:load />

    </div>

  </section>

  <!-- ESTADÍSTICAS -->

  <section class="stats container">

    <div class="stat-card">
      <span class="port-label">PORT 01</span>
      <h2>10+</h2>
      <p>Años de experiencia</p>
    </div>

    <div class="stat-card">
      <span class="port-label">PORT 02</span>
      <h2>1000+</h2>
      <p>Activos gestionados</p>
    </div>

    <div class="stat-card">
      <span class="port-label">PORT 03</span>
      <h2>100+</h2>
      <p>Switches administrados</p>
    </div>

    <div class="stat-card">
      <span class="port-label">PORT 04</span>
      <h2>20+</h2>
      <p>Proyectos tecnológicos</p>
    </div>

  </section>

  <!-- STACK TECNOLÓGICO -->

  <section class="container">

    <span class="eyebrow">Stack</span>
    <h2 class="title">
      Herramientas que uso
    </h2>

    <div class="tech-grid">

      <span>Python</span>
      <span>React</span>
      <span>Astro</span>
      <span>FastAPI</span>
      <span>Node.js</span>
      <span>Docker</span>
      <span>PostgreSQL</span>
      <span>Cisco</span>
      <span>Fortinet</span>
      <span>Dell EMC</span>

    </div>

  </section>

  <section class="container">

    <span class="eyebrow">Proyecto destacado</span>
    <h2 class="title">
      Corporate Infrastructure Dashboard
    </h2>

    <div class="featured-project">

      <h3>
        Visibilidad centralizada de la flota TI
      </h3>

      <p>
        Plataforma interna para dar seguimiento a activos TI,
        infraestructura Dell y switches corporativos: inventario,
        disponibilidad e indicadores clave en un solo lugar.
      </p>

      <div class="tech-grid">

        <span>Astro</span>
        <span>React</span>
        <span>FastAPI</span>
        <span>PostgreSQL</span>
        <span>Docker</span>

      </div>

      <a href="/dashboard" class="btn-secondary">Ver dashboard →</a>

    </div>

  </section>

  <Footer />

</MainLayout>

<style>

.hero{
  min-height: 68vh;
  display: flex;
  align-items: center;
  padding-top: 50px;
}

.hero-content {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 50px;
  align-items: center;
}

.badge {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.8rem;
  letter-spacing: 0.04em;
  border: 1px solid var(--accent);
  color: var(--accent);
  padding: 7px 16px;
  border-radius: 6px;
}

.hero h1 {
  font-size: 3.6rem;
  margin: 20px 0;
}

.hero p {
  font-size: 1.1rem;
  line-height: 1.65;
  color: var(--text-muted);
  max-width: 46ch;
}

.buttons {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  margin-top: 32px;
}

.featured-project .btn-secondary {
  margin-top: 22px;
}

@media (max-width: 900px) {

  .hero-content {
    grid-template-columns: 1fr;
  }

  .hero h1 {
    font-size: 2.6rem;
  }

}

</style>
