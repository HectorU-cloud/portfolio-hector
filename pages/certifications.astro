---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const certifications = [
  "ITIL Foundation",
  "Scrum Fundamentals",
  "Cisco Networking",
  "Python Development",
  "Cloud Fundamentals",
];
---

<MainLayout title="Certificaciones">

<Navbar />

<div class="container">

<span class="eyebrow">Formación</span>
<h1 class="title">
Certificaciones
</h1>

<div class="grid">
  {certifications.map(cert => (
    <div class="card cert-card">
      <span class="cert-name">{cert}</span>
    </div>
  ))}
</div>

</div>
<Footer />
</MainLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
  }

  .cert-card {
    display: flex;
    align-items: center;
    padding: 20px 22px;
  }

  .cert-name {
    font-weight: 500;
  }
</style>
